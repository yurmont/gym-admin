{
  "name": "gym-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-frontend.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @gym-admin/backend",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test:backend": "npm test --workspace @gym-admin/backend",
    "build:backend": "npm run build --workspace @gym-admin/backend",
    "dev:backend": "npm run build:backend && npm run dev --workspace @gym-admin/backend",
    "db:migrate": "npm run migrate --workspace @gym-admin/backend"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.66.9",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-sql-cst": "0.22.1",
    "prettier-plugin-toml": "2.0.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "workspaces": [
    "backend"
  ]
}
