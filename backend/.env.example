# Local PostgreSQL from compose.yaml. Use a pooled Neon URL in Cloud Run.
DATABASE_URL=postgresql://gym_admin:local-development-only@127.0.0.1:54329/gym_admin
# Use a direct Neon URL for migrations; leave empty locally to use DATABASE_URL.
DATABASE_DIRECT_URL=
DB_POOL_MAX=3
PORT=8080
NODE_ENV=development
FIREBASE_PROJECT_ID=demo-gym-admin
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GCS_BUCKET_NAME=replace-with-private-bucket
CORS_ORIGINS=http://localhost:3000
# Live local GCS/Firebase Admin uses Application Default Credentials:
# gcloud auth application-default login
# Production uses the Cloud Run service account, not a downloaded private key.
